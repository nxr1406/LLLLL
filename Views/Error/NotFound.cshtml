@{
    ViewData["Title"] = "404 - Page Not Found";
    Layout = "_ErrorLayout";
}
  <main class="flex-grow flex items-center justify-center relative overflow-hidden px-6 py-20" role="main">
    
    <!-- Decorative Mandalas -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full border border-gold/10 animate-[spin_40s_linear_infinite] pointer-events-none" aria-hidden="true"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[450px] h-[450px] rounded-full border border-gold/15 animate-[spin_60s_linear_infinite_reverse] pointer-events-none" aria-hidden="true"></div>
    
    <!-- Content Container -->
    <div class="relative z-10 text-center max-w-2xl mx-auto animate-float">
      
      <!-- Spiritual Subtitle -->
      <p class="font-display text-gold-dark tracking-[0.3em] text-sm md:text-base mb-2 uppercase font-semibold">
        ‖ পথ হারিয়েছেন ‖
      </p>
      
      <!-- 404 Graphic -->
      <div class="relative inline-block mb-4">
        <h1 class="font-display font-extrabold text-[120px] md:text-[180px] leading-none gold-text-gradient drop-shadow-sm select-none" aria-label="404 Error">
          404
        </h1>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-5xl md:text-7xl text-white/90 om-glow font-display pointer-events-none mix-blend-overlay" aria-hidden="true">
          ॐ
        </div>
      </div>
      
      <!-- Error Messages -->
      <h2 class="font-display font-bold text-2xl md:text-4xl mb-4 text-ink">
        The Path Was Not Found
      </h2>
      <p class="text-gray-600 mb-10 text-base md:text-lg max-w-md mx-auto">
        দুঃখিত, আপনি যে পৃষ্ঠাটি খুঁজছেন তা সম্ভবত মুছে ফেলা হয়েছে বা এর নাম পরিবর্তন করা হয়েছে। চলুন সঠিক পথে ফিরে যাই।
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
        <a href="/" class="gold-gradient text-white font-semibold px-8 py-3.5 rounded-full shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex items-center gap-2 group w-full sm:w-auto justify-center" aria-label="Return to Ashram (Home)">
          <svg class="group-hover:-translate-x-1 transition-transform" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
          Return to Ashram (Home)
        </a>
        <a href="https://m.me/j/AbbcfM0JpuKtZBey/" class="border-2 border-gold text-gold font-semibold px-8 py-3.5 rounded-full hover:bg-gold hover:text-white transition-all duration-300 w-full sm:w-auto text-center shadow-sm hover:shadow-lg" aria-label="Join our Community">
          Join Community
        </a>
      </div>
      
    </div>
  </main>