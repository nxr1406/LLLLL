@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="min-h-[70vh] flex items-center justify-center bg-sand pt-24 pb-16 px-6">
    <div class="text-center max-w-lg">
        <h1 class="font-display font-extrabold text-5xl md:text-6xl text-ink mb-4">ॐ</h1>
        <h2 class="font-display font-bold text-2xl md:text-3xl text-ink mb-3">Something Went Wrong</h2>
        <p class="text-ink/60 mb-6">An unexpected error occurred while processing your request.</p>

        @if (Model?.ShowRequestId == true)
        {
            <p class="text-xs text-ink/40 mb-8">
                <strong>Request ID:</strong> <code>@Model.RequestId</code>
            </p>
        }

        <a href="/" class="inline-flex items-center gap-2 gold-gradient text-white font-semibold px-8 py-3.5 rounded-full shadow-lg hover:shadow-gold/40 hover:-translate-y-1 transition-all duration-300">
            Back to Home
        </a>
    </div>
</section>
