@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<main id="main">

<!-- ================= PAGE INTRO ================= -->
<section class="hero-bg relative overflow-hidden">
  <div class="absolute -bottom-16 left-1/2 -translate-x-1/2 w-[500px] h-[500px] rounded-full chakra-rays-soft motion-safe:animate-[spin_60s_linear_infinite]" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto px-6 py-16 md:py-20 text-center relative z-10">
    <p class="divider-orn text-gold-dark tracking-[0.3em] text-xs md:text-sm font-semibold uppercase inline-flex items-center justify-center mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-sindoor tilak-dot mr-3" aria-hidden="true"></span>Welcome To Our Group
    </p>
    <div class="text-5xl mb-3 om-glow text-gold font-display">ॐ</div>
    <h1 class="font-display font-extrabold text-4xl md:text-6xl leading-tight mb-4">Rules &amp; <span class="text-gold">Warnings</span></h1>
    <p class="text-ink-soft/80 max-w-lg mx-auto">গ্রুপে অংশ নেওয়ার আগে অনুগ্রহ করে নিচের নিয়মগুলো মনোযোগ দিয়ে পড়ুন — এটা আমাদের সবার জন্য একটা নিরাপদ ও সুন্দর পরিবার গড়ে তোলে।</p>
  </div>
</section>

<!-- ================= RULES GRID ================= -->
<section class="max-w-5xl mx-auto px-6 py-16 md:py-20">
  <h2 class="font-display font-bold text-3xl text-center mb-12">
    <span class="divider-orn text-gold inline-flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-sindoor tilak-dot mr-3" aria-hidden="true"></span>OUR GROUP RULES</span>
  </h2>

  <div class="grid md:grid-cols-2 gap-6">

    <!-- Rule 01 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:0ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">01</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="16" y1="11" x2="22" y2="11"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Introduction Is Mandatory</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">নতুন মেম্বার গ্রুপে আসলে প্রথমেই ইনট্রো দিতে হবে। ইনট্রো না দিলে গ্রুপে অ্যাক্টিভ থাকার সুযোগ থাকবে না।</p>
          <ul class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1 text-xs text-ink-soft/80">
            <li>▸ নাম (Name)</li>
            <li>▸ বয়স (Age)</li>
            <li>▸ লোকেশন (Location)</li>
            <li>▸ কীভাবে এলে (How you found us)</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Rule 02 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:40ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">02</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Old & New Members Are Equal</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">পুরাতন মেম্বারদের সম্মান যেমন আছে তেমনই থাকবে। নতুনদেরও সমান সুযোগ ও সম্মান দেওয়া হবে। কেউ কাউকে ছোট করে দেখবেন না।</p>
        </div>
      </div>
    </div>

    <!-- Rule 03 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:80ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">03</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><polygon points="12,2 20,5 20,11 12,21 4,11 4,5" fill="none"/><line x1="12" y1="8" x2="12" y2="13"/><circle cx="12" cy="16.5" r="1" fill="currentColor" stroke="none"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Report To Admin / Owner</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">গ্রুপে কোনো ঝামেলা বা সমস্যা হলে সরাসরি ওনার বা অ্যাডমিনকে জানাতে হবে। নিজে থেকে পাল্টা ব্যবস্থা নেওয়া যাবে না। অ্যাডমিনরা সবসময় নিরপেক্ষভাবে সমাধান করবেন।</p>
        </div>
      </div>
    </div>

    <!-- Rule 04 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:120ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">04</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">No Asking For Admin Role</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">অ্যাডমিন বা মডারেটর পদ চেয়ে কাউকে বিব্রত করবেন না। যোগ্যতা ও আচরণ দেখে ওনার নিজেই সিদ্ধান্ত নেবেন। বারবার পদ চাইলে সেটি নেতিবাচকভাবে দেখা হবে।</p>
        </div>
      </div>
    </div>

    <!-- Rule 05 — zero tolerance -->
    <div class="reveal card-hover bg-white rounded-2xl border-2 border-sindoor/60 p-6" style="transition-delay:160ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full bg-sindoor text-gold-light font-display font-bold flex items-center justify-center">05</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 flex-wrap text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><polygon points="12,2 20,5 20,11 12,21 4,11 4,5" fill="none"/><polyline points="8.5,12 11,14.5 16,9"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Respect For Women Is Mandatory</h3>
            <span class="bg-sindoor/10 text-sindoor text-[10px] font-semibold px-2 py-0.5 rounded-full">তাৎক্ষণিক রিমুভ</span>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">কোনো মেয়েকে অসম্মান, কটূক্তি বা বাজে মন্তব্য করলে সাথে সাথে রিমুভ করা হবে — কোনো সতর্কতা ছাড়াই। মেয়েদের ছবি বা পোস্ট নিয়ে নেগেটিভ কমেন্ট নিষিদ্ধ। এই গ্রুপের প্রতিটি মেয়ে পূর্ণ নিরাপত্তা পাওয়ার অধিকারী।</p>
        </div>
      </div>
    </div>

    <!-- Rule 06 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:200ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">06</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><rect x="3" y="4" width="18" height="12" rx="2"/><polygon points="8,16 8,20 12,16" fill="currentColor" stroke="none"/><line x1="4" y1="3" x2="20" y2="19"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Inbox / DM / Follow Requests</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">বিনা অনুমতিতে কাউকে DM বা Follow Request পাঠানো নিষেধ। মেয়ে মেম্বারদের ওনারের অনুমতি ছাড়া ইনবক্স করা যাবে না।</p>
          <p class="text-xs text-sindoor mt-2 font-medium">১ম অভিযোগ → সতর্কতা &nbsp;•&nbsp; ২য় অভিযোগ → সরাসরি রিমুভ</p>
        </div>
      </div>
    </div>

    <!-- Rule 07 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:240ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">07</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><rect x="3" y="4" width="18" height="12" rx="2"/><polygon points="8,16 8,20 12,16" fill="currentColor" stroke="none"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">No Excessive Flattery</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">অতিরিক্ত চাপাবাজি বা মিথ্যা প্রশংসা করলে গ্রুপ থেকে বের করে দেওয়া হবে। সৎ ও স্বাভাবিকভাবে কথা বলুন।</p>
        </div>
      </div>
    </div>

    <!-- Rule 08 — zero tolerance -->
    <div class="reveal card-hover bg-white rounded-2xl border-2 border-sindoor/60 p-6 md:col-span-2" style="transition-delay:280ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full bg-sindoor text-gold-light font-display font-bold flex items-center justify-center">08</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 flex-wrap text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><circle cx="12" cy="12" r="9"/><line x1="5.5" y1="5.5" x2="18.5" y2="18.5"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">Inappropriate Content Is Fully Banned</h3>
            <span class="bg-sindoor/10 text-sindoor text-[10px] font-semibold px-2 py-0.5 rounded-full">তাৎক্ষণিক রিমুভ</span>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed mb-2">নিচের যেকোনো কিছু শেয়ার করলে সাথে সাথে রিমুভ:</p>
          <ul class="grid sm:grid-cols-2 gap-x-4 gap-y-1 text-sm text-ink-soft/90">
            <li class="flex items-center gap-2"><span class="text-sindoor font-bold">✗</span> অশ্লীল ভিডিও বা ছবি</li>
            <li class="flex items-center gap-2"><span class="text-sindoor font-bold">✗</span> বাজে লিংক বা স্টিকার</li>
            <li class="flex items-center gap-2"><span class="text-sindoor font-bold">✗</span> ধর্ম বা রাজনীতি নিয়ে উত্তেজনামূলক পোস্ট</li>
            <li class="flex items-center gap-2"><span class="text-sindoor font-bold">✗</span> Spam বা বারবার একই পোস্ট</li>
            <li class="flex items-center gap-2"><span class="text-sindoor font-bold">✗</span> অন্য গ্রুপের প্রমোশনাল লিংক</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Rule 09 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:320ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">09</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><path d="M17 21v-2a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">No Personal Attacks</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">কারো পরিবার, চেহারা বা ব্যক্তিগত জীবন নিয়ে কোনো মন্তব্য করা কঠোরভাবে নিষিদ্ধ। মতের অমিল হলে ভদ্রভাবে আলোচনা করুন।</p>
        </div>
      </div>
    </div>

    <!-- Rule 10 -->
    <div class="reveal card-hover bg-white rounded-2xl border border-gold/20 p-6" style="transition-delay:360ms">
      <div class="flex items-start gap-4">
        <div class="shrink-0 w-11 h-11 rounded-full gold-gradient text-white font-display font-bold flex items-center justify-center">10</div>
        <div class="flex-1">
          <div class="flex items-center gap-2 mb-1 text-gold-dark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 shrink-0"><rect x="3" y="7" width="18" height="13" rx="2"/><polygon points="9,7 10.5,4 13.5,4 15,7" fill="none"/><circle cx="12" cy="13.5" r="3.5"/><line x1="2" y1="3" x2="22" y2="21"/></svg>
            <h3 class="font-display font-bold text-lg text-ink">No Screenshots / Screen Recording</h3>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed">গ্রুপের কোনো কথোপকথন বা সদস্যদের তথ্য বাইরে শেয়ার করা সম্পূর্ণ নিষিদ্ধ। গোপনীয়তা সবার জন্য সমান গুরুত্বপূর্ণ।</p>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ================= ESCALATION ================= -->
<section class="bg-white border-y border-gold/15">
  <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
    <h2 class="font-display font-bold text-3xl text-center mb-3">
      <span class="divider-orn text-gold inline-flex items-center"><span class="w-1.5 h-1.5 rounded-full bg-sindoor tilak-dot mr-3" aria-hidden="true"></span>IF RULES ARE BROKEN</span>
    </h2>
    <p class="text-center text-gray-500 mb-12 text-sm">Every case is handled fairly, step by step</p>

    <div class="flex flex-col md:flex-row items-stretch gap-4">
      <div class="reveal flex-1 text-center bg-cream rounded-2xl p-8 border-2 border-gold">
        <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-gold text-white flex items-center justify-center text-2xl">⚠️</div>
        <p class="font-display font-bold text-lg mb-1">1st Offense</p>
        <p class="text-sm text-gray-500">Warning (সতর্কতা)</p>
      </div>
      <div class="hidden md:flex items-center text-gold/40 shrink-0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><polyline points="9,6 15,12 9,18"/></svg>
      </div>
      <div class="reveal flex-1 text-center bg-cream rounded-2xl p-8 border-2 border-gold-dark" style="transition-delay:100ms">
        <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-gold-dark text-white flex items-center justify-center text-2xl">🔇</div>
        <p class="font-display font-bold text-lg mb-1">2nd Offense</p>
        <p class="text-sm text-gray-500">Restrict / Mute</p>
      </div>
      <div class="hidden md:flex items-center text-gold/40 shrink-0">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-7 h-7"><polyline points="9,6 15,12 9,18"/></svg>
      </div>
      <div class="reveal flex-1 text-center bg-cream rounded-2xl p-8 border-2 border-sindoor" style="transition-delay:200ms">
        <div class="w-14 h-14 mx-auto mb-3 rounded-full bg-sindoor text-white flex items-center justify-center text-2xl">❌</div>
        <p class="font-display font-bold text-lg mb-1">3rd Offense</p>
        <p class="text-sm text-gray-500">Permanent Remove</p>
      </div>
    </div>
  </div>
</section>

<!-- ================= CLOSING QUOTE ================= -->
<section class="max-w-5xl mx-auto px-6 py-16 md:py-20">
  <div class="reveal relative rounded-2xl overflow-hidden gold-gradient p-10 md:p-14 text-center">
    <div class="absolute inset-0 chakra-rays-soft" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/25 to-black/55"></div>
    <div class="relative">
      <p class="text-white text-lg font-semibold mb-8">✅ নিয়ম মানুন। গ্রুপ উপভোগ করুন। 🤍</p>
      <div class="relative max-w-xl mx-auto">
        <span class="absolute -top-8 left-1/2 -translate-x-1/2 font-display text-7xl text-white/20 select-none" aria-hidden="true">&ldquo;</span>
        <p class="font-display italic text-white text-xl md:text-2xl relative">সুন্দর গ্রুপ তখনই গড়ে ওঠে, যখন সবাই মিলে নিয়ম মানে।</p>
      </div>
      <p class="text-gold-light font-display mt-6">— Group Authority 🖤</p>
      <p class="text-white/70 text-sm">Nirob Sarkar, Founder</p>
    </div>
  </div>
</section>

</main>
